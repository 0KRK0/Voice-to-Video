# Voice-to-Video configuration.
#
# Copy to `.env` for local development. `.env` is git-ignored and must never be
# committed. In every deployed environment these values come from a secrets
# manager, injected at runtime — see docs/SECURITY.md.
#
# EVERY KEY BELOW IS READ BY `vtv.config.Settings.from_env`. That is asserted by
# `tests/test_deployment.py`, because an example file naming variables nothing
# reads is worse than no example: an operator sets one, nothing happens, and the
# default silently governs production. This file previously listed
# `VTV_REDIS_URL` and `VTV_ASSET_SEARCH_API_KEY`, which the code has never read.
#
# It also listed `VTV_STORAGE_ACCESS_KEY` and `VTV_STORAGE_SECRET_KEY` back when
# they were read by nothing. They are read now — the S3 adapter is real — and
# they are documented again below. Both directions of this can be wrong, and
# only one of them is tested: the test catches a documented variable nothing
# reads, not a read variable nothing documents.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
VTV_ENV=development           # development | staging | production
VTV_LOG_LEVEL=info            # debug | info | warning | error

# ---------------------------------------------------------------------------
# Security
#
# VTV_SIGNING_KEY signs media URLs. It has NO default in production and the
# process refuses to start without it, because a per-process key means a URL
# signed by one replica is rejected by the next — so a customer's download fails
# roughly half the time behind a load balancer. Generate with:
#
#     openssl rand -hex 32
#
# The SAME value must reach every API replica and every worker.
# ---------------------------------------------------------------------------
VTV_SIGNING_KEY=
VTV_SIGNED_URL_SECONDS=900
VTV_ALLOWED_ORIGINS=http://localhost:8000

# ---------------------------------------------------------------------------
# Storage
#
# Which backend runs is decided by whether the two credentials below are set —
# there is deliberately no VTV_STORAGE_BACKEND name to get out of sync with
# them. Set both and every write goes to S3 (or R2, MinIO, B2, Ceph, Wasabi);
# leave either blank and it is the local filesystem.
#
# Local filesystem is correct for a single host. VTV_STORAGE_ROOT must be a path
# every replica and every worker can read and write — in
# `deploy/docker-compose.yml` that is one shared volume, and it is what makes
# two replicas mean anything. The one combination refused at startup is a
# `postgresql://` database URL with local storage: a shared database means the
# replicas do not share a disk, so the render succeeds on the worker and 404s on
# the API.
# ---------------------------------------------------------------------------
VTV_STORAGE_ROOT=./var/storage
VTV_STORAGE_BUCKET=vtv-media-dev
VTV_STORAGE_REGION=us-east-1
# Set only when an S3-compatible endpoint is in use. Blank means AWS at
# https://s3.<region>.amazonaws.com.
VTV_STORAGE_ENDPOINT=
# Both required together to select S3. Leave blank for local disk.
VTV_STORAGE_ACCESS_KEY=
VTV_STORAGE_SECRET_KEY=
# Path-style addressing (host/bucket/key). MinIO and Ceph require it; AWS and R2
# accept it. Set false only for a DNS-safe bucket on an endpoint that expects
# virtual-hosted style.
VTV_STORAGE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Datastores
#
# Only `sqlite:///` is implemented. Any other scheme raises at startup rather
# than falling back to a local file — see wiring.repository_path, and P1-5 in
# docs/REMEDIATION.md for PostgreSQL.
#
# The queue (queue.db) and the shared rate-limit state (shared.db) are placed
# alongside it, in the parent of VTV_STORAGE_ROOT.
# ---------------------------------------------------------------------------
VTV_DATABASE_URL=sqlite:///./var/vtv.db

# ---------------------------------------------------------------------------
# Providers
#
# Credentials and endpoints only. Which provider is used for what is a routing
# decision made from declared capabilities at runtime, not a hard-coded choice —
# see docs/AI_PROVIDER_POLICY.md.
#
# Leave any of these blank and that capability is simply not registered. The
# pipeline degrades visibly rather than substituting something plausible:
# `/health` reports which are missing, and a render produced without speech
# synthesis is returned with outcome `degraded`, not `ready`.
#
# ENDPOINTS: either the base or the full URL works. `…/v1` and
# `…/v1/chat/completions` both reach the same place — each adapter appends its
# own path only when the configured value does not already carry it. What is
# NOT interchangeable is a path pointing at a *different* API: these adapters
# speak Chat Completions, so `…/v1/responses` is a real misconfiguration and
# will fail rather than be quietly rewritten.
# ---------------------------------------------------------------------------
VTV_SPEECH_TO_TEXT_ENDPOINT=
VTV_SPEECH_TO_TEXT_API_KEY=
# Raw user speech only goes to a provider whose data policy has been verified,
# and the defaults assume it has not been: an unknown vendor is treated as
# retaining and training on what it is sent, which excludes it from the voice
# path. With a credential configured but these unset, `/health` reports
# `real_transcription: false` and transcription genuinely does not run.
#
# These are assertions about a contract you have signed with the vendor — not
# switches to make transcription start. Set them when that is true.
VTV_SPEECH_TO_TEXT_DPA=false
VTV_SPEECH_TO_TEXT_TRAINS_ON_INPUT=true
VTV_SPEECH_TO_TEXT_RETAINS_INPUT=true

# Narration is synthesised one sentence per request, and each sentence's audio
# is measured before the pieces are joined. That is what makes the captions and
# the pictures sit on the voice: the previous version sent the whole script as
# one request and scaled the estimated timings to fit the total, which is right
# at the end of the video and progressively wrong in the middle. On a five
# sentence test script the worst per-sentence error went from 3.05s to 0.000s.
#
# The joined track is WAV, not MP3, because joining MP3 files inserts about
# 37 ms of encoder padding at every seam — measured, not assumed — which is the
# same drift arriving by a different route.
# Any OpenAI-compatible speech endpoint. This adapter speaks that contract and
# nothing about it is vendor-specific, so a local server is a URL change rather
# than a code change. Kokoro-FastAPI (Apache-2.0, CPU, ~30x realtime) is the one
# this was tested against:
#
#     docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu
#     VTV_SPEECH_SYNTHESIS_ENDPOINT=http://localhost:8880/v1
#     VTV_SPEECH_SYNTHESIS_MODEL=kokoro
#     VTV_SPEECH_SYNTHESIS_API_KEY=not-needed
#     VTV_SPEECH_SYNTHESIS_VOICE=af_heart
#
# A local synthesiser costs nothing per minute, which matters more than it
# sounds: narration is the one provider call a video cannot do without, and a
# render that loses it produces silence rather than a worse picture.
VTV_SPEECH_SYNTHESIS_ENDPOINT=
VTV_SPEECH_SYNTHESIS_API_KEY=
VTV_SPEECH_SYNTHESIS_MODEL=unset
VTV_SPEECH_SYNTHESIS_VOICE=alloy

VTV_TEXT_GENERATION_ENDPOINT=
VTV_TEXT_GENERATION_API_KEY=
VTV_TEXT_GENERATION_MODEL=unset

# ---------------------------------------------------------------------------
# Limits
#
# The longest video this deployment accepts, in minutes. Blank means the
# engineering ceiling in `contracts/scale.py` — four hours.
#
# This can only ever *tighten*. `scale.ceiling_minutes` takes the lesser of
# this and that ceiling, because a .env file cannot make the contracts hold
# more than they hold: set 600 and you get 240, not a validation error a user
# cannot act on. Set 15 to give a free tier fifteen minutes and it is enforced.
# ---------------------------------------------------------------------------
VTV_MAX_PROJECT_MINUTES=

# ---------------------------------------------------------------------------
# How many video segments to draw at once.
#
# Frame composition is PIL and Python — CPU-bound, and parallel across
# processes rather than threads, because the GIL serialises exactly the part
# that is slow. Blank means "as many as this machine has cores, capped at 8".
#
# Measured on a two-core machine, a sixty-second video: 1.78x real time on one
# worker, 1.29x on two. The per-core rate does not change; the number of cores
# does. Set this to 1 on a machine that is also serving the API, so a render
# cannot starve requests.
#
# Rendering is also checkpointed: video is encoded in twelve-second segments,
# and a segment on disk is finished by definition. A render killed by a power
# cut resumes at the segment it reached rather than at frame zero, and the
# segments live beside VTV_STORAGE_ROOT until the render succeeds or a day
# passes, whichever comes first.
# ---------------------------------------------------------------------------
VTV_RENDER_WORKERS=

VTV_IMAGE_GENERATION_ENDPOINT=
VTV_IMAGE_GENERATION_API_KEY=
# No default: an image endpoint has no one right model, and "default" is not a
# real model name for any vendor's image API — it used to be sent literally and
# every request was rejected. With a credential configured but this unset,
# `/health` reports `real_image_generation: false` rather than claiming a
# provider that cannot work. For OpenAI: dall-e-2, dall-e-3, gpt-image-1,
# gpt-image-1-mini, gpt-image-1.5, or gpt-image-2.
VTV_IMAGE_GENERATION_MODEL=unset
# low | medium | high. Blank sends nothing and the vendor's default applies.
#
# THIS IS THE LARGEST COST LEVER IN THE PRODUCT. OpenAI's published per-image
# price for the 1536x1024 size a 16:9 shot lands on:
#
#     low     $0.016
#     medium  $0.063
#     high    $0.25      <- fifteen times low
#
# Blank sends nothing and gets the vendor's default, which measured at $0.25 a
# shot on a real render — so blank is also the one value whose price cannot be
# predicted, and budget checks assume `high` for it.
#
# `low` is the default here. At 1536x1024 it is still 1.5 megapixels and a
# sixteenth of the price. Render the same script at `low` and at `high` and
# look at both before deciding — that is a judgement about the product.
#
# As of the picture-quality control in the Studio, this is a **default for
# projects that have not chosen**, not a cap on the ones that have. A project
# whose owner selected Draft, Standard or Fine gets that tier regardless of what
# is set here, and is billed and budget-planned at that tier's published price.
# The instrument for capping what a project may spend is its budget, which is
# enforced in money rather than in tiers — `VTV_MAX_PROJECT_COST_USD` is the
# deployment-wide backstop.
VTV_IMAGE_GENERATION_QUALITY=low

VTV_VIDEO_GENERATION_ENDPOINT=
VTV_VIDEO_GENERATION_API_KEY=
# Same reasoning as VTV_IMAGE_GENERATION_MODEL above.
VTV_VIDEO_GENERATION_MODEL=unset
# Which video API the endpoint speaks. There is no way to tell from a URL, and
# guessing wrong is a 404 on every request — which reads to a user as "video is
# configured and nothing ever appears", not as a misconfiguration.
#
#   poll    (default) create at .../video/generations, poll by id, download
#           from a `url` on the finished job. Runway and Luma published this.
#   openai  create at .../videos, poll at .../videos/{id}, download the bytes
#           from .../videos/{id}/content. Use with https://api.openai.com/v1
#           and a Sora model.
#
# The two are different APIs, not different spellings: OpenAI hands back bytes
# where the other hands back a URL, so neither adapter can serve both.
VTV_VIDEO_GENERATION_DIALECT=poll

# Openly-licensed media search — the second rung of the visual ladder, and the
# one that costs nothing. Set by default and needs no credential.
#
# This was configured, wired and never reached. `SceneComposer` called the
# resolver without `organisation_id`, which raised `TypeError` rather than a
# `VTVError`, so the ladder could not even descend past it — and every test that
# covered the rung used a stub accepting any arguments, so nothing noticed.
# Fixed, and `tests/test_asset_resolution.py` now drives it through the real
# resolver.
#
# Blank disables searching entirely and the ladder goes straight to generation
# (if configured) and then to typography. The test suite sets it blank; see
# `TheSuiteNeverReachesTheInternet` in tests/test_architecture_boundaries.py.
VTV_ASSET_SEARCH_ENDPOINT=https://api.openverse.org/v1

# ---------------------------------------------------------------------------
# Debugging what a render costs
#
# Writes one JSON line per provider call to a local file, and echoes a readable
# line to the worker's output as each call happens. Then:
#
#     python -m vtv.trace_report                  # where the money went
#     python -m vtv.trace_report --calls          # every call, in order
#     python -m vtv.trace_report --job JOB_ID     # one render
#
# OFF BY DEFAULT AND REFUSED IN PRODUCTION. The file contains prompt text,
# which is user content — that is the whole point of it, and it is why this is a
# separate facility from the event stream, which forbids user content without
# exception. Treat the file like a heap dump: local, useful, never shipped.
# ---------------------------------------------------------------------------
VTV_TRACE_PROVIDER_CALLS=false
# Blank means ./var/provider-calls.jsonl
VTV_TRACE_PATH=

# ---------------------------------------------------------------------------
# Budgets and limits
#
# Ceilings, not targets. A project that would exceed these degrades to cheaper
# visual strategies rather than overspending.
# ---------------------------------------------------------------------------
VTV_MAX_PROJECT_COST_USD=1.00
VTV_MAX_RECORDING_SECONDS=1800
VTV_TEMPORARY_RETENTION_HOURS=24
VTV_MAX_UPLOAD_BYTES=209715200

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
VTV_RENDERER=ffmpeg
VTV_REMOTION_PROJECT_DIR=./apps/remotion

# ---------------------------------------------------------------------------
# Whose computer this process runs on: `cloud` (ours) or `local` (the
# customer's machine — the desktop engine).
#
# Rendering is the only cost that scales with the length of somebody's video,
# so where the frames are composed is a business decision, not a deployment
# detail. A local render is free to us, faster for the customer — nobody is
# sharing those cores — and has no ceiling on project length.
#
# Today this changes one thing: which execution target `/health` reports as
# ready. It changes no behaviour, because only a CPU renderer exists. It is
# named now so the desktop build is a setting rather than a fork. See
# `src/vtv/contracts/execution.py`.
# ---------------------------------------------------------------------------
VTV_EXECUTION_MACHINE=cloud
