{
  "$defs": {
    "AudioFormat": {
      "description": "Container/codec of the captured audio.\n\n``WEBM_OPUS`` is what browser ``MediaRecorder`` produces on Chromium and is\ntherefore the format the primary capture path must always support.",
      "enum": [
        "webm/opus",
        "ogg/opus",
        "mp4/aac",
        "wav/pcm",
        "mp3",
        "flac"
      ],
      "title": "AudioFormat",
      "type": "string"
    },
    "AudioProperties": {
      "additionalProperties": false,
      "description": "Measured properties of the audio, filled in after probing the file.\n\nThese are *measured*, not *claimed*: the client may report a duration, but\nthe value stored here comes from server-side probing. Client-reported values\nare hints only and are never trusted for billing or timeline construction.",
      "properties": {
        "bit_rate_bps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bit Rate Bps"
        },
        "channels": {
          "maximum": 8,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0.0,
          "maximum": 86400,
          "title": "Duration Seconds",
          "type": "number"
        },
        "peak_dbfs": {
          "anyOf": [
            {
              "maximum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Dbfs"
        },
        "sample_rate_hz": {
          "maximum": 192000,
          "minimum": 8000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "silence_ratio": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Silence Ratio"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "duration_seconds",
        "sample_rate_hz",
        "channels"
      ],
      "title": "AudioProperties",
      "type": "object"
    },
    "CaptureSource": {
      "description": "How the audio entered the system.\n\nThe product is voice-first: ``MICROPHONE`` is the primary path and ``UPLOAD``\nis the secondary one (see ``docs/PRODUCT.md``). Keeping the distinction in\nthe data lets us measure whether that stays true.",
      "enum": [
        "microphone",
        "upload",
        "api"
      ],
      "title": "CaptureSource",
      "type": "string"
    },
    "ErrorCategory": {
      "description": "Coarse classification that determines how the system reacts.",
      "enum": [
        "validation",
        "provider",
        "provider_refused",
        "policy",
        "not_found",
        "timeout",
        "internal"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "ErrorCode": {
      "description": "Stable, machine-readable error codes.\n\nThese are part of the public contract: they appear in API responses and in\nmetrics, so they may be added to but must not be renamed.",
      "enum": [
        "schema_invalid",
        "audio_unreadable",
        "audio_too_long",
        "audio_silent",
        "transcription_failed",
        "understanding_failed",
        "scene_planning_failed",
        "visual_planning_failed",
        "asset_not_found",
        "asset_license_unacceptable",
        "generation_failed",
        "generation_refused",
        "budget_exceeded",
        "latency_exceeded",
        "render_failed",
        "storage_unavailable",
        "object_expired",
        "provider_unavailable",
        "rate_limited",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "Serialisable description of a failure, safe to store and to return.\n\n``message`` is for engineers and goes to logs. ``user_message`` is for the\nperson who spoke into the microphone and must never leak provider names,\nstack traces, prompts or internal identifiers.",
      "properties": {
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        },
        "message": {
          "maxLength": 2000,
          "title": "Message",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "user_message": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Message"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "description": "A pointer to a blob in object storage.\n\nBusiness logic never learns a filesystem path, a bucket URL, or a vendor\nname from this type. Turning an ``ObjectRef`` into readable bytes or a signed\nURL is the sole responsibility of the ``StorageProvider`` port.",
      "properties": {
        "bucket": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Bucket",
          "type": "string"
        },
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        },
        "content_type": {
          "description": "IANA media type, e.g. 'audio/webm' or 'image/png'.",
          "maxLength": 128,
          "minLength": 3,
          "title": "Content Type",
          "type": "string"
        },
        "key": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "retention": {
          "$ref": "#/$defs/RetentionClass",
          "default": "ephemeral"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "required": [
        "bucket",
        "key",
        "content_type"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "RetentionClass": {
      "description": "How long the bytes behind an :class:`ObjectRef` are allowed to live.\n\nRetention is a property of the object itself so that lifecycle rules can be\napplied by the storage layer without it having to understand the domain\n(see ``docs/STORAGE_POLICY.md``).",
      "enum": [
        "ephemeral",
        "project",
        "archive"
      ],
      "title": "RetentionClass",
      "type": "string"
    },
    "Status": {
      "description": "Lifecycle status shared by recordings, scenes, assets and render jobs.",
      "enum": [
        "pending",
        "processing",
        "ready",
        "failed",
        "retrying",
        "expired",
        "deleted"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "$id": "https://schemas.voice-to-video.dev/recording.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A single captured utterance, and the root of one pipeline run.",
  "properties": {
    "audio": {
      "$ref": "#/$defs/ObjectRef"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "declared_language": {
      "anyOf": [
        {
          "maxLength": 16,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared Language"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "format": {
      "$ref": "#/$defs/AudioFormat"
    },
    "project_id": {
      "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
      "title": "Project Id",
      "type": "string"
    },
    "properties": {
      "anyOf": [
        {
          "$ref": "#/$defs/AudioProperties"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recording_id": {
      "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
      "title": "Recording Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "description": "Contract bundle version this document was written with.",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/CaptureSource",
      "default": "microphone"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "default": "pending"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "project_id",
    "format",
    "audio"
  ],
  "title": "Recording",
  "type": "object",
  "x-contracts-version": "1.0"
}
