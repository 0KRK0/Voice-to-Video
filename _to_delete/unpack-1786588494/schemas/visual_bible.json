{
  "$defs": {
    "BindingKind": {
      "description": "What kind of decision is being held constant.",
      "enum": [
        "asset",
        "colour",
        "icon",
        "label",
        "position"
      ],
      "title": "BindingKind",
      "type": "string"
    },
    "BindingSource": {
      "description": "Where the decision came from. Determines whether it may be revised.",
      "enum": [
        "automatic",
        "user",
        "brand",
        "source"
      ],
      "title": "BindingSource",
      "type": "string"
    },
    "ContinuityIssue": {
      "additionalProperties": false,
      "description": "A consistency problem found during review.\n\nRecorded rather than silently corrected. Some are genuine defects and some\nare deliberate — a deck that intentionally recolours a diagram — and the\nsystem is not in a position to tell the difference, so it reports.",
      "properties": {
        "entity_name": {
          "maxLength": 200,
          "title": "Entity Name",
          "type": "string"
        },
        "problem": {
          "maxLength": 300,
          "title": "Problem",
          "type": "string"
        },
        "scene_id": {
          "anyOf": [
            {
              "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "severity": {
          "default": "warning",
          "maxLength": 16,
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "entity_name",
        "problem"
      ],
      "title": "ContinuityIssue",
      "type": "object"
    },
    "EntityBinding": {
      "additionalProperties": false,
      "description": "One entity's fixed visual identity for the length of a project.",
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Aliases",
          "type": "array"
        },
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "binding_id": {
          "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
          "title": "Binding Id",
          "type": "string"
        },
        "canonical_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Canonical Name",
          "type": "string"
        },
        "colour": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colour"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "entity_id": {
          "anyOf": [
            {
              "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "kind": {
          "$ref": "#/$defs/BindingKind",
          "default": "asset"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "position": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "source": {
          "$ref": "#/$defs/BindingSource",
          "default": "automatic"
        },
        "used_in_scenes": {
          "items": {
            "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Used In Scenes",
          "type": "array"
        }
      },
      "required": [
        "canonical_name"
      ],
      "title": "EntityBinding",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "description": "A pointer to a blob in object storage.\n\nBusiness logic never learns a filesystem path, a bucket URL, or a vendor\nname from this type. Turning an ``ObjectRef`` into readable bytes or a signed\nURL is the sole responsibility of the ``StorageProvider`` port.",
      "properties": {
        "bucket": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Bucket",
          "type": "string"
        },
        "checksum_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum Sha256"
        },
        "content_type": {
          "description": "IANA media type, e.g. 'audio/webm' or 'image/png'.",
          "maxLength": 128,
          "minLength": 3,
          "title": "Content Type",
          "type": "string"
        },
        "key": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "retention": {
          "$ref": "#/$defs/RetentionClass",
          "default": "ephemeral"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "required": [
        "bucket",
        "key",
        "content_type"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PaletteLock": {
      "additionalProperties": false,
      "description": "Colours reserved across the whole project.\n\nSeparate from the style profile because these are *semantic* assignments —\nthis colour means this thing — rather than aesthetic ones. Reusing a\nreserved colour for an unrelated element is the subtle version of the\ninconsistency this module exists to prevent.",
      "properties": {
        "reserved": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Reserved",
          "type": "object"
        },
        "used": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Used",
          "type": "array"
        }
      },
      "title": "PaletteLock",
      "type": "object"
    },
    "RetentionClass": {
      "description": "How long the bytes behind an :class:`ObjectRef` are allowed to live.\n\nRetention is a property of the object itself so that lifecycle rules can be\napplied by the storage layer without it having to understand the domain\n(see ``docs/STORAGE_POLICY.md``).",
      "enum": [
        "ephemeral",
        "project",
        "archive"
      ],
      "title": "RetentionClass",
      "type": "string"
    },
    "Status": {
      "description": "Lifecycle status shared by recordings, scenes, assets and render jobs.",
      "enum": [
        "pending",
        "processing",
        "ready",
        "failed",
        "retrying",
        "expired",
        "deleted"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "$id": "https://schemas.voice-to-video.dev/visual_bible.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Every visual decision that must hold across a whole project.\n\nBuilt after visual direction and before composition, then stored with the\nproject so a re-render reproduces the same video rather than a similar one.",
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/EntityBinding"
      },
      "maxItems": 400,
      "title": "Bindings",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ContinuityIssue"
      },
      "maxItems": 200,
      "title": "Issues",
      "type": "array"
    },
    "palette": {
      "$ref": "#/$defs/PaletteLock"
    },
    "project_id": {
      "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "description": "Contract bundle version this document was written with.",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "default": "pending"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "visual_bible_id": {
      "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
      "title": "Visual Bible Id",
      "type": "string"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "VisualBible",
  "type": "object",
  "x-contracts-version": "1.0"
}
