{
  "$id": "https://schemas.voice-to-video.dev/user.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A human principal. May belong to several organisations.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "disabled": {
      "default": false,
      "title": "Disabled",
      "type": "boolean"
    },
    "display_name": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Name"
    },
    "email": {
      "maxLength": 320,
      "minLength": 3,
      "title": "Email",
      "type": "string"
    },
    "last_seen_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Seen At"
    },
    "mfa_enabled": {
      "default": false,
      "title": "Mfa Enabled",
      "type": "boolean"
    },
    "password_hash": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Password Hash"
    },
    "schema_version": {
      "default": "1.0",
      "description": "Contract bundle version this document was written with.",
      "title": "Schema Version",
      "type": "string"
    },
    "sso_subject": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sso Subject"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "user_id": {
      "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
      "title": "User Id",
      "type": "string"
    }
  },
  "required": [
    "email"
  ],
  "title": "User",
  "type": "object",
  "x-contracts-version": "1.0"
}
