{
  "$defs": {
    "AspectRatio": {
      "description": "Delivery shape. Chosen up front because it changes composition, not just\ncropping: a portrait explainer wants stacked layouts, not letterboxed ones.",
      "enum": [
        "16:9",
        "9:16",
        "1:1"
      ],
      "title": "AspectRatio",
      "type": "string"
    },
    "ColorPalette": {
      "additionalProperties": false,
      "description": "A small, deliberate palette. Hex strings, validated.",
      "properties": {
        "accent": {
          "default": "#4C8DFF",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Accent",
          "type": "string"
        },
        "background": {
          "default": "#0B0D10",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background",
          "type": "string"
        },
        "foreground": {
          "default": "#F5F7FA",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Foreground",
          "type": "string"
        },
        "muted": {
          "default": "#7A8598",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Muted",
          "type": "string"
        },
        "secondary": {
          "default": "#FFB65C",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Secondary",
          "type": "string"
        }
      },
      "title": "ColorPalette",
      "type": "object"
    },
    "ErrorCategory": {
      "description": "Coarse classification that determines how the system reacts.",
      "enum": [
        "validation",
        "provider",
        "provider_refused",
        "policy",
        "not_found",
        "timeout",
        "internal"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "ErrorCode": {
      "description": "Stable, machine-readable error codes.\n\nThese are part of the public contract: they appear in API responses and in\nmetrics, so they may be added to but must not be renamed.",
      "enum": [
        "schema_invalid",
        "audio_unreadable",
        "audio_too_long",
        "audio_silent",
        "transcription_failed",
        "understanding_failed",
        "scene_planning_failed",
        "visual_planning_failed",
        "asset_not_found",
        "asset_license_unacceptable",
        "generation_failed",
        "generation_refused",
        "budget_exceeded",
        "latency_exceeded",
        "render_failed",
        "storage_unavailable",
        "object_expired",
        "provider_unavailable",
        "rate_limited",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "Serialisable description of a failure, safe to store and to return.\n\n``message`` is for engineers and goes to logs. ``user_message`` is for the\nperson who spoke into the microphone and must never leak provider names,\nstack traces, prompts or internal identifiers.",
      "properties": {
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        },
        "message": {
          "maxLength": 2000,
          "title": "Message",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "user_message": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Message"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "MotionIntensity": {
      "enum": [
        "calm",
        "moderate",
        "energetic"
      ],
      "title": "MotionIntensity",
      "type": "string"
    },
    "PersistenceMode": {
      "description": "How long this project's data is kept.",
      "enum": [
        "temporary",
        "saved"
      ],
      "title": "PersistenceMode",
      "type": "string"
    },
    "PipelineStage": {
      "description": "The ordered stages every project passes through.\n\nNaming them lets progress be reported honestly (\"understanding your\nrecording\" rather than a spinner), lets failures be attributed precisely, and\ngives the evaluation system its natural unit of measurement.",
      "enum": [
        "capture",
        "transcription",
        "understanding",
        "scene_planning",
        "visual_direction",
        "asset_resolution",
        "composition",
        "rendering"
      ],
      "title": "PipelineStage",
      "type": "string"
    },
    "ProcessingConsent": {
      "additionalProperties": false,
      "description": "What the user has agreed to.\n\nConsent is stored per project and defaults to the most conservative setting.\nNothing about a recording may be used to improve the product unless this\nsays so explicitly, and the flag travels with the data so that a later\ntraining-data export cannot accidentally include material that was never\noffered (``docs/SECURITY.md``).",
      "properties": {
        "accepted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted At"
        },
        "human_review": {
          "default": false,
          "title": "Human Review",
          "type": "boolean"
        },
        "improve_product": {
          "default": false,
          "title": "Improve Product",
          "type": "boolean"
        }
      },
      "title": "ProcessingConsent",
      "type": "object"
    },
    "StageState": {
      "additionalProperties": false,
      "description": "Status of one pipeline stage.",
      "properties": {
        "cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "stage": {
          "$ref": "#/$defs/PipelineStage"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "pending"
        }
      },
      "required": [
        "stage"
      ],
      "title": "StageState",
      "type": "object"
    },
    "Status": {
      "description": "Lifecycle status shared by recordings, scenes, assets and render jobs.",
      "enum": [
        "pending",
        "processing",
        "ready",
        "failed",
        "retrying",
        "expired",
        "deleted"
      ],
      "title": "Status",
      "type": "string"
    },
    "StyleProfile": {
      "additionalProperties": false,
      "description": "The style contract every scene must honour.",
      "properties": {
        "aspect_ratio": {
          "$ref": "#/$defs/AspectRatio",
          "default": "16:9"
        },
        "captions_enabled": {
          "default": true,
          "title": "Captions Enabled",
          "type": "boolean"
        },
        "direction": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "motion": {
          "$ref": "#/$defs/MotionIntensity",
          "default": "moderate"
        },
        "palette": {
          "$ref": "#/$defs/ColorPalette"
        },
        "style": {
          "$ref": "#/$defs/VisualStyle",
          "default": "explainer"
        },
        "typeface": {
          "default": "grotesque",
          "maxLength": 32,
          "title": "Typeface",
          "type": "string"
        }
      },
      "title": "StyleProfile",
      "type": "object"
    },
    "VisualStyle": {
      "description": "The register of the finished video.",
      "enum": [
        "documentary",
        "explainer",
        "editorial",
        "technical",
        "cinematic",
        "minimal",
        "playful"
      ],
      "title": "VisualStyle",
      "type": "string"
    }
  },
  "$id": "https://schemas.voice-to-video.dev/project.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The root aggregate for one voice-to-video run.",
  "properties": {
    "consent": {
      "$ref": "#/$defs/ProcessingConsent"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "owner_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Id"
    },
    "persistence": {
      "$ref": "#/$defs/PersistenceMode",
      "default": "temporary"
    },
    "project_id": {
      "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
      "title": "Project Id",
      "type": "string"
    },
    "recording_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recording Id"
    },
    "render_job_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Render Job Id"
    },
    "scene_graph_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scene Graph Id"
    },
    "schema_version": {
      "default": "1.0",
      "description": "Contract bundle version this document was written with.",
      "title": "Schema Version",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageState"
      },
      "title": "Stages",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "default": "pending"
    },
    "style": {
      "$ref": "#/$defs/StyleProfile"
    },
    "timeline_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeline Id"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "total_cost_usd": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Total Cost Usd",
      "type": "number"
    },
    "transcript_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transcript Id"
    },
    "understanding_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Understanding Id"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "visual_plan_id": {
      "anyOf": [
        {
          "pattern": "^[a-z]{3}_[0-9a-hjkmnp-tv-z]{20,26}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visual Plan Id"
    }
  },
  "title": "Project",
  "type": "object",
  "x-contracts-version": "1.0"
}
