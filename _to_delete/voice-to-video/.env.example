# Voice-to-Video configuration.
#
# Copy to `.env` for local development. `.env` is git-ignored and must never be
# committed. In every deployed environment these values come from a secrets
# manager, injected at runtime — see docs/SECURITY.md.
#
# Stage 0 defines no runtime configuration of its own: the contracts and ports
# packages read no environment at all. This file is the shape configuration will
# take when adapters arrive, so that nobody has to invent it under pressure.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
VTV_ENV=development           # development | staging | production
VTV_LOG_LEVEL=info            # debug | info | warning | error

# ---------------------------------------------------------------------------
# Storage (S3-compatible)
# ---------------------------------------------------------------------------
VTV_STORAGE_BUCKET=vtv-media-dev
VTV_STORAGE_ENDPOINT=http://localhost:9000
VTV_STORAGE_REGION=us-east-1
VTV_STORAGE_ACCESS_KEY=
VTV_STORAGE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
VTV_DATABASE_URL=postgresql://vtv:vtv@localhost:5432/vtv
VTV_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Providers
#
# Credentials only. Which provider is used for what is a routing decision made
# from declared capabilities at runtime, not a hard-coded choice — see
# docs/AI_PROVIDER_POLICY.md.
# ---------------------------------------------------------------------------
VTV_SPEECH_TO_TEXT_API_KEY=
VTV_TEXT_GENERATION_API_KEY=
VTV_IMAGE_GENERATION_API_KEY=
VTV_VIDEO_GENERATION_API_KEY=
VTV_ASSET_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# Budgets and limits
#
# Ceilings, not targets. A project that would exceed these degrades to cheaper
# visual strategies rather than overspending.
# ---------------------------------------------------------------------------
VTV_MAX_PROJECT_COST_USD=1.00
VTV_MAX_RECORDING_SECONDS=1800
VTV_TEMPORARY_RETENTION_HOURS=24
